# Data backend: "local" (default, IndexedDB, no setup needed) or "firestore".
# See docs/db-design.md for what each backend actually does.
VITE_DATA_PROVIDER=local

# Only needed when VITE_DATA_PROVIDER=firestore. No Firebase project exists
# for budgetwheel yet — these are placeholders until one is created (see
# docs/db-design.md's "Not yet done"). Like every sibling repo's Firebase
# web config, these are public client identifiers once real, not secrets.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Only set by the dealer app's build (npm run build:dealer / dev:dealer —
# see vite.config.ts). Flips AuthContext's first-sign-in provisioning to
# type: 'dealer' instead of 'consumer'.
VITE_APP_ROLE=

# Only used by the dealer app build. Where CrossAppRedirect sends any path
# it doesn't own (e.g. /browse, /sell) — the consumer app's real URL.
VITE_CONSUMER_APP_URL=

# Only used by the consumer app build. Where DesktopHeader's "Dealer
# Portal" nav item links a dealer account back to — the dealer app's URL.
VITE_DEALER_APP_URL=
