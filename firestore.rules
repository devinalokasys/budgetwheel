rules_version = '2';

// Matches the schema in docs/db-design.md / src/lib/db/schema.ts. Seed data
// (npm run seed:firestore) writes via the Admin SDK, which bypasses these
// rules entirely — so nothing here needs a special-case for seeding.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Own profile only — mirrors chess-master's users/{uid} pattern.
    // `type` (consumer vs dealer) is set once at creation and locked after —
    // db.putUser is only ever called at first-sign-in provisioning, so a
    // client has no legitimate reason to change it post-creation. Without
    // this, any signed-in consumer could self-grant dealer status via a
    // direct Firestore write and walk straight past DealerRoute's UI gate.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.type == resource.data.type;
    }

    // Public read (dealer name/tier shown on public listings). Only the
    // dealer themself can write their own profile, and only once their
    // users/{uid} doc says type == 'dealer' (set by the dealer app's
    // registration flow) — matches the get() pattern tradeSubmissions uses.
    match /dealerProfiles/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.type == 'dealer';
    }

    // Public read (the whole point is a public marketplace). Only the
    // seller can create/update their own listing; no client-side delete
    // (the app soft-deletes via the status field).
    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if signedIn() && resource.data.sellerId == request.auth.uid;
      allow delete: if false;
    }

    // Public read (listing photos). Any signed-in user may add images;
    // no update/delete — images are immutable once attached.
    match /images/{imageId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Public read (Carfax badges on public listings). Never written by
    // client code — seed-only via Admin SDK.
    match /carfaxReports/{reportId} {
      allow read: if true;
      allow write: if false;
    }

    // Owner-only. Doc id convention is `${userId}_${listingId}`, but the
    // rule checks the stored userId field rather than parsing the id.
    match /savedListings/{savedId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /savedSearches/{searchId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Dealers can browse every open submission (that's the Deal Pipeline);
    // a consumer can only read their own — not browse other sellers'
    // mileage/asking price/VIN. Any signed-in consumer may still create
    // one (submitting a trade-in doesn't require being a dealer).
    match /tradeSubmissions/{submissionId} {
      allow read: if signedIn() && (
        resource.data.sellerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'dealer'
      );
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if signedIn() && resource.data.sellerId == request.auth.uid;
      allow delete: if false;
    }

    // Visible only to the two parties. Either side may create; only the
    // recipient updates (accept/decline).
    match /offers/{offerId} {
      allow read: if signedIn() &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if signedIn() && resource.data.toUserId == request.auth.uid;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if signedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow delete: if false;
    }

    match /messages/{messageId} {
      function conversation() {
        return get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data;
      }
      function newConversation() {
        return get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data;
      }

      allow read: if signedIn() &&
        (conversation().buyerId == request.auth.uid || conversation().sellerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid &&
        (newConversation().buyerId == request.auth.uid || newConversation().sellerId == request.auth.uid);
      allow update, delete: if false;
    }
  }
}
